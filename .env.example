# Backend environment variables
APP_NAME=AI-Driven Academic Compliance System (ADCS)
APP_ENV=development
DEBUG=True

SECRET_KEY=change-me-to-a-long-random-secret
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60

# MySQL
DB_HOST=localhost
DB_PORT=3306
DB_USER=adcs_user
DB_PASSWORD=adcs_password
DB_NAME=adcs_db

# CORS
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# SMTP (optional)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM_EMAIL=noreply@adcs.local
SMTP_FROM_NAME=ADCS
SMTP_TLS=True

SUPER_ADMIN_EMAIL=superadmin@adcs.local
SUPER_ADMIN_PASSWORD=ChangeMe123!
SUPER_ADMIN_FULL_NAME=Platform Super Administrator
