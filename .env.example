 # Copy to server/.env and client/.env as needed.

# --- Server (server/.env) ---
DATABASE_URL="postgresql://academic:academic@localhost:5432/academic_compliance?schema=public"
JWT_SECRET="change-this-to-a-long-random-secret"
JWT_EXPIRES_IN="8h"
PORT=4000
CLIENT_ORIGIN="http://localhost:5173"
NODE_ENV="development"
ALLOW_STUDENT_REGISTER="true"
COOKIE_SECURE="false"

# Optional SMTP (leave empty to log OTP in the server console)
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM="Academic Compliance <noreply@university.edu>"

# Optional OpenAI-compatible API. If empty, a local deterministic analyzer is used.
AI_API_KEY=
AI_API_BASE_URL="https://api.openai.com/v1"
AI_MODEL="gpt-4o-mini"

# --- Client (client/.env) ---
# VITE_API_URL is optional when using the Vite proxy in development.
VITE_API_URL=
