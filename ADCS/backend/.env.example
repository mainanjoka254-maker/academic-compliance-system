APP_NAME=AI-Driven Academic Compliance System (ADCS)
APP_ENV=development
DEBUG=True

SECRET_KEY=change-me-to-a-long-random-secret
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60

DB_HOST=127.0.0.1
DB_PORT=3306
DB_USER=adcs_user
DB_PASSWORD=replace-with-a-unique-secret
DB_NAME=adcs_db

CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
FRONTEND_BASE_URL=http://localhost:5173

# Google OAuth 2.0 / OpenID Connect (leave blank to disable Google Sign-In)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:8000/api/v1/auth/google/callback

# Private document storage (defaults to backend/private_uploads)
# DOCUMENT_STORAGE_PATH=C:\path\to\private\adcs_uploads
MAX_DOCUMENT_SIZE_BYTES=10485760

SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM_EMAIL=noreply@adcs.local
SMTP_FROM_NAME=ADCS
SMTP_TLS=True

# Optional one-time bootstrap administrator. Leave blank to skip admin creation.
# Before running seed.py, set a unique email and a random password of at least
# 16 characters containing lowercase, uppercase, numeric, and symbol characters.
SUPER_ADMIN_EMAIL=
SUPER_ADMIN_PASSWORD=
SUPER_ADMIN_FULL_NAME=Platform Super Administrator
