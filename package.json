{
  "name": "academic-compliance",
  "private": true,
  "version": "1.0.0",
  "description": "AI-Driven Academic Compliance System",
  "scripts": {
    "dev": "concurrently -n server,client -c blue,green \"npm run dev --prefix server\" \"npm run dev --prefix client\"",
    "build": "npm run build --prefix server; npm run build --prefix client",
    "start": "powershell -ExecutionPolicy Bypass -File scripts/start-system.ps1",
    "db:up": "docker compose up -d",
    "db:migrate": "npm run prisma:migrate --prefix server",
    "db:seed": "npm run prisma:seed --prefix server",
    "db:reset": "npm run prisma:reset --prefix server"
  },
  "devDependencies": {
    "concurrently": "^9.1.2"
  }
}
