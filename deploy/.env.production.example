# ADCS production environment (DO NOT COMMIT real values)
# Copy to deploy/.env.production and fill with strong, unique secrets.

APP_NAME=AI-Driven Academic Compliance System (ADCS)
APP_ENV=production
DEBUG=False
API_V1_PREFIX=/api/v1

# Security - REQUIRED (32+ chars, random)
SECRET_KEY=REPLACE_WITH_A_LONG_RANDOM_SECRET_AT_LEAST_32_CHARS
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60
REFRESH_TOKEN_EXPIRE_DAYS=7
PASSWORD_RESET_TOKEN_EXPIRE_MINUTES=30
EMAIL_OTP_EXPIRE_MINUTES=10

# Public frontend URL (no domain yet? use http://<DROPLET_IP>; add https://yourdomain when ready)
FRONTEND_BASE_URL=http://YOUR_PUBLIC_HOST

# CORS - include your public frontend origin(s)
CORS_ORIGINS=http://YOUR_PUBLIC_HOST

# Database (Docker Compose sets DB_HOST=db; for managed MySQL set DB_HOST to the private host)
DB_HOST=db
DB_PORT=3306
DB_USER=adcs_user
DB_PASSWORD=REPLACE_WITH_STRONG_DB_PASSWORD
DB_NAME=adcs_db
DB_ECHO=False
MYSQL_ROOT_PASSWORD=REPLACE_WITH_STRONG_ROOT_PASSWORD

# Google OAuth (optional)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=

# SMTP (optional; required for verification/reset emails)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM_EMAIL=
SMTP_FROM_NAME=ADCS
SMTP_TLS=True

# Bootstrap super admin (one-time; use strong credentials, then remove/rotate)
SUPER_ADMIN_EMAIL=
SUPER_ADMIN_PASSWORD=
SUPER_ADMIN_FULL_NAME=Platform Super Administrator

# Rate limits / uploads
RATE_LIMIT_LOGIN=5/minute
RATE_LIMIT_REGISTER=3/minute
RATE_LIMIT_ACCOUNT_STATUS=10/minute
MAX_DOCUMENT_SIZE_BYTES=10485760
SEED_DEMO_DATA=False

PUBLIC_HTTP_PORT=80